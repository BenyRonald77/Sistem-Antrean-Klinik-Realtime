# Database (gunakan PostgreSQL di production, SQLite cukup untuk development lokal)
DATABASE_URL="file:./dev.db"

# Auth
JWT_SECRET="ganti-dengan-secret-acak-yang-panjang"

# Timezone klinik (dipakai untuk reset nomor antrean harian)
CLINIC_TIMEZONE="Asia/Jakarta"

# Port server custom (Next.js + Socket.IO)
PORT=3000

# WhatsApp Notification Provider
# Pilihan: "mock" (default, hanya mencatat log, tidak mengirim WA sungguhan) | "fonnte"
WA_PROVIDER="mock"
WA_FONNTE_TOKEN=""
WA_FONNTE_BASE_URL="https://api.fonnte.com/send"

# Jumlah sisa antrean sebelum notifikasi "hampir giliran" dikirim
WA_NOTIFY_BEFORE_TURNS=3
