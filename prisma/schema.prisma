// Prisma schema — Sistem Antrean Klinik Realtime
// Default provider: SQLite (mudah dijalankan lokal tanpa setup server DB).
// Untuk production, ganti provider ke "postgresql" dan sesuaikan DATABASE_URL
// (lihat README.md bagian Deployment).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Clinic {
  id        String   @id @default(cuid())
  name      String
  timezone  String   @default("Asia/Jakarta")
  createdAt DateTime @default(now())

  services   Service[]
  counters   Counter[]
  adminUsers AdminUser[]
}

model Service {
  id        String   @id @default(cuid())
  clinicId  String
  name      String
  prefix    String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  clinic       Clinic          @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  queueEntries QueueEntry[]
  counters     CounterService[]

  @@unique([clinicId, prefix])
}

model Counter {
  id        String   @id @default(cuid())
  clinicId  String
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  clinic       Clinic           @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  services     CounterService[]
  queueEntries QueueEntry[]
}

// Relasi many-to-many: satu loket bisa menangani beberapa poli/layanan
model CounterService {
  counterId String
  serviceId String

  counter Counter @relation(fields: [counterId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([counterId, serviceId])
}

// role disimpan sebagai String ("STAFF" | "SUPERADMIN") — lihat src/lib/constants.ts
model AdminUser {
  id           String   @id @default(cuid())
  clinicId     String
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("STAFF")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)
}

// status disimpan sebagai String ("WAITING" | "CALLED" | "SKIPPED" | "DONE")
// lihat src/lib/constants.ts untuk daftar nilai yang valid
model QueueEntry {
  id            String    @id @default(cuid())
  serviceId     String
  counterId     String?
  queueDate     String // format YYYY-MM-DD (timezone klinik) — dasar reset harian
  number        Int // nomor urut harian per service
  code          String // contoh: "A-001"
  patientName   String
  patientPhone  String
  status        String    @default("WAITING")
  calledAt      DateTime?
  doneAt        DateTime?
  createdAt     DateTime  @default(now())

  service            Service            @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  counter            Counter?           @relation(fields: [counterId], references: [id])
  notificationLogs   NotificationLog[]

  @@unique([serviceId, queueDate, number])
  @@index([serviceId, queueDate, status])
}

// type disimpan sebagai String ("ISSUED" | "ALMOST_TURN" | "CALLED")
// status disimpan sebagai String ("SENT" | "FAILED")
model NotificationLog {
  id           String   @id @default(cuid())
  queueEntryId String
  type         String
  phone        String
  status       String
  providerName String
  responseInfo String?
  createdAt    DateTime @default(now())

  queueEntry QueueEntry @relation(fields: [queueEntryId], references: [id], onDelete: Cascade)
}
